        function saveProductCRUD() {
            const isEdit = document.getElementById('product-form-id').value !== '';
            const sku = document.getElementById('product-form-sku').value.trim(); const name = document.getElementById('product-form-name').value.trim();
            const category = document.getElementById('product-form-cat').value; const subcategory = document.getElementById('product-form-subcat').value;
            const sizesRaw = document.getElementById('product-form-sizes').value.trim(); const imageInput = document.getElementById('product-form-image-url').value.trim();

            if(!sku || !name || !category || !sizesRaw) return showToast("SKU, Nombre, Categoría y Tallas son obligatorios", "error");

            const validSizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s !== '');
            if(validSizes.length === 0) return showToast("Debes ingresar al menos una talla", "error");
            
            const image = imageInput || `https://placehold.co/150x150/f8fafc/475569?text=${name.substring(0,3)}`;

            if(isEdit) {
                const prod = mockProducts.find(p => p.sku === sku);
                if(prod) {
                    prod.name = name; prod.category = category; prod.subcategory = subcategory; prod.validSizes = validSizes; prod.image = image;
                    validSizes.forEach(s => { if(prod.stock.almacen_central[s] === undefined) prod.stock.almacen_central[s] = 0; mockBranches.forEach(b => { if(prod.stock[b.id] === undefined) prod.stock[b.id] = {}; if(prod.stock[b.id][s] === undefined) prod.stock[b.id][s] = 0; }); });
                    showToast("Ficha de producto actualizada");
                }
            } else {
                if(mockProducts.some(p => p.sku === sku)) return showToast("El SKU ya existe", "error");
                const newStock = { almacen_central: {} }; validSizes.forEach(s => newStock.almacen_central[s] = 0);
                mockBranches.forEach(b => { newStock[b.id] = {}; validSizes.forEach(s => newStock[b.id][s] = 0); });
                mockProducts.unshift({ sku, name, category, subcategory, avgCost: 0, image, validSizes, stock: newStock });
                showToast("Nuevo producto registrado en el Maestro");
            }
            cancelEditProduct(); renderProductsCRUD(document.getElementById('crud-product-search').value); updateDashboard();
        }

