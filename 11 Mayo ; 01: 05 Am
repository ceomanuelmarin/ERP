                container.innerHTML += `<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm hover:shadow-md transition-shadow relative group"><div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity"><button onclick="editBranch('${branch.id}')" class="text-brand-500 hover:text-brand-700 bg-brand-50 p-1.5 rounded-lg"><i class="ph-fill ph-pencil-simple text-lg"></i></button><button onclick="promptDelete('branch', '${branch.id}')" class="text-rose-400 hover:text-rose-600 bg-rose-50 p-1.5 rounded-lg"><i class="ph-fill ph-trash text-lg"></i></button></div><div class="flex items-center pr-16 mb-3"><div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center font-bold text-lg mr-3"><i class="ph-fill ph-storefront"></i></div><div><h3 class="font-bold text-slate-800 leading-tight">${branch.name}</h3><p class="text-[10px] text-slate-500 uppercase tracking-widest mt-0.5">ID: ${branch.id}</p></div></div><div class="space-y-2 text-sm text-slate-600 border-t border-slate-100 pt-3"><p class="flex items-start"><i class="ph ph-map-pin mr-2 mt-0.5 text-slate-400"></i> <span class="truncate">${branch.address}</span></p><p class="flex items-center"><i class="ph ph-user mr-2 text-slate-400"></i> ${branch.manager}</p><p class="flex items-center"><i class="ph ph-phone mr-2 text-slate-400"></i> ${branch.phone}</p></div></div>`;
            });
        }
        function editBranch(id) { const branch = mockBranches.find(b => b.id === id); if(!branch) return; document.getElementById('branch-form-id').value = branch.id; document.getElementById('branch-name').value = branch.name; document.getElementById('branch-address').value = branch.address; document.getElementById('branch-manager').value = branch.manager; document.getElementById('branch-phone').value = branch.phone; document.getElementById('branch-submit-btn').innerHTML = '<i class="ph ph-arrows-clockwise mr-2 text-lg"></i> Actualizar'; document.getElementById('branch-cancel-btn').classList.remove('hidden'); }
        function cancelEditBranch() { document.getElementById('branch-form-id').value = ''; document.getElementById('branch-name').value = ''; document.getElementById('branch-address').value = ''; document.getElementById('branch-manager').value = ''; document.getElementById('branch-phone').value = ''; document.getElementById('branch-submit-btn').innerHTML = '<i class="ph ph-plus-circle mr-2 text-lg"></i> Guardar'; document.getElementById('branch-cancel-btn').classList.add('hidden'); }
        function addBranch() { const idInput = document.getElementById('branch-form-id').value; const name = document.getElementById('branch-name').value.trim(); const address = document.getElementById('branch-address').value.trim(); const manager = document.getElementById('branch-manager').value.trim(); const phone = document.getElementById('branch-phone').value.trim(); if(!name || !address) return showToast("Nombre y Dirección obligatorios", "error"); if(idInput) { const branch = mockBranches.find(b => b.id === idInput); if(branch) { branch.name = name; branch.address = address; branch.manager = manager; branch.phone = phone; showToast("Sucursal actualizada"); } } else { const newId = `tienda_${Date.now()}`; mockBranches.push({ id: newId, name, address, manager, phone }); mockProducts.forEach(p => p.stock[newId] = {}); showToast("Sucursal creada"); } cancelEditBranch(); renderBranches(); updateDropdowns(); }

        function renderCouriers() {
            const container = document.getElementById('couriers-container'); container.innerHTML = '';
            mockCouriers.forEach(courier => {
                let contactsHtml = courier.contacts && courier.contacts.length > 0 ? courier.contacts.map(c => `<p class="flex items-start text-xs"><i class="ph ph-phone mr-1.5 mt-0.5 text-slate-400"></i> <span><b class="text-slate-700">${c.role}:</b> ${c.phone}</span></p>`).join('') : `<p class="text-xs text-slate-400 italic">Sin contactos.</p>`;
                container.innerHTML += `<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm hover:shadow-md transition-shadow relative group flex flex-col h-full"><div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity"><button onclick="editCourier('${courier.id}')" class="text-brand-500 hover:text-brand-700 bg-brand-50 p-1.5 rounded-lg"><i class="ph-fill ph-pencil-simple text-lg"></i></button><button onclick="promptDelete('courier', '${courier.id}')" class="text-rose-400 hover:text-rose-600 bg-rose-50 p-1.5 rounded-lg"><i class="ph-fill ph-trash text-lg"></i></button></div><div class="flex items-center pr-16 mb-4"><div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-xl mr-3"><i class="ph-fill ph-airplane-tilt"></i></div><div><h3 class="font-bold text-slate-800">${courier.name}</h3><p class="text-[10px] text-slate-500 uppercase tracking-widest break-all">${courier.email}</p></div></div><div class="flex-1 text-sm text-slate-600 space-y-2"><p class="flex items-start"><i class="ph ph-map-pin mr-1.5 mt-0.5 text-slate-400"></i> <span>${courier.address}</span></p><div class="pt-2 border-t border-slate-100 space-y-1">${contactsHtml}</div></div></div>`;
            });
        }
        function editCourier(id) { const courier = mockCouriers.find(c => c.id === id); if(!courier) return; document.getElementById('courier-form-id').value = courier.id; document.getElementById('courier-name').value = courier.name; document.getElementById('courier-address').value = courier.address; document.getElementById('courier-email').value = courier.email; document.getElementById('courier-notes').value = courier.notes || ''; document.getElementById('courier-contacts-container').innerHTML = ''; if(courier.contacts) { courier.contacts.forEach(c => addCourierContactRow(c.role, c.phone)); } document.getElementById('courier-submit-btn').innerHTML = '<i class="ph ph-arrows-clockwise mr-2 text-lg"></i> Actualizar'; document.getElementById('courier-cancel-btn').classList.remove('hidden'); }
        function cancelEditCourier() { document.getElementById('courier-form-id').value = ''; document.getElementById('courier-name').value = ''; document.getElementById('courier-address').value = ''; document.getElementById('courier-email').value = ''; document.getElementById('courier-notes').value = ''; document.getElementById('courier-contacts-container').innerHTML = ''; document.getElementById('courier-submit-btn').innerHTML = '<i class="ph ph-floppy-disk mr-2 text-lg"></i> Guardar'; document.getElementById('courier-cancel-btn').classList.add('hidden'); }
        function addCourierContactRow(role = '', phone = '') { const container = document.getElementById('courier-contacts-container'); const rowId = 'contact-row-' + Date.now(); const div = document.createElement('div'); div.className = "flex gap-2 items-end courier-contact-row"; div.id = rowId; div.innerHTML = `<div class="flex-1"><input type="text" placeholder="Cargo" value="${role}" class="contact-role w-full border border-slate-200 rounded-md p-1.5 text-xs mb-1 outline-none"><input type="text" placeholder="Teléfono" value="${phone}" class="contact-phone w-full border border-slate-200 rounded-md p-1.5 text-xs outline-none"></div><button onclick="document.getElementById('${rowId}').remove()" class="bg-rose-50 text-rose-500 hover:bg-rose-100 p-2 rounded-md h-full"><i class="ph-fill ph-x text-sm"></i></button>`; container.appendChild(div); }
        function saveCourier() { const idInput = document.getElementById('courier-form-id').value; const name = document.getElementById('courier-name').value.trim(); const address = document.getElementById('courier-address').value.trim(); const email = document.getElementById('courier-email').value.trim(); const notes = document.getElementById('courier-notes').value.trim(); if(!name) return showToast("Nombre obligatorio", "error"); const contacts = []; document.querySelectorAll('.courier-contact-row').forEach(row => { const r = row.querySelector('.contact-role').value.trim(); const p = row.querySelector('.contact-phone').value.trim(); if(r||p) contacts.push({role: r||'Contacto', phone: p}); }); if(idInput) { const c = mockCouriers.find(c => c.id === idInput); if(c) { c.name=name; c.address=address; c.email=email; c.notes=notes; c.contacts=contacts; showToast("Courier actualizado"); } } else { mockCouriers.push({id: `cour_${Date.now()}`, name, address, email, contacts, notes}); showToast("Courier creado"); } cancelEditCourier(); renderCouriers(); updateDropdowns(); }

        function renderUsers() {
            const container = document.getElementById('users-container'); if(!container) return; container.innerHTML = '';
            mockUsers.forEach(u => { container.innerHTML += `<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm hover:shadow-md transition-shadow relative group"><div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity"><button onclick="editUser('${u.id}')" class="text-brand-500 hover:text-brand-700 bg-brand-50 p-1.5 rounded-lg"><i class="ph-fill ph-pencil-simple text-lg"></i></button><button onclick="promptDelete('user', '${u.id}')" class="text-rose-400 hover:text-rose-600 bg-rose-50 p-1.5 rounded-lg"><i class="ph-fill ph-trash text-lg"></i></button></div><div class="flex items-center pr-16 mb-3"><div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-lg mr-3"><i class="ph-fill ph-user"></i></div><div><h3 class="font-bold text-slate-800 leading-tight">${u.name}</h3><p class="text-[10px] text-brand-600 uppercase font-bold mt-0.5">${u.role}</p></div></div><div class="space-y-2 text-sm text-slate-600 border-t border-slate-100 pt-3"><p><i class="ph ph-identification-card mr-2 text-slate-400"></i> CI: ${u.ci}</p><p><i class="ph ph-phone mr-2 text-slate-400"></i> ${u.phone}</p></div></div>`; });
        }
        function editUser(id) { const u = mockUsers.find(u => u.id === id); if(!u) return; document.getElementById('user-form-id').value=u.id; document.getElementById('user-form-name').value=u.name; document.getElementById('user-form-ci').value=u.ci; document.getElementById('user-form-phone').value=u.phone; document.getElementById('user-form-role').value=u.role; document.getElementById('user-submit-btn').innerHTML='<i class="ph ph-arrows-clockwise mr-2 text-lg"></i> Actualizar'; document.getElementById('user-cancel-btn').classList.remove('hidden'); }
        function cancelEditUser() { document.getElementById('user-form-id').value=''; document.getElementById('user-form-name').value=''; document.getElementById('user-form-ci').value=''; document.getElementById('user-form-phone').value=''; document.getElementById('user-form-role').value=''; document.getElementById('user-submit-btn').innerHTML='<i class="ph ph-plus-circle mr-2 text-lg"></i> Guardar'; document.getElementById('user-cancel-btn').classList.add('hidden'); }
        function addUser() { const id = document.getElementById('user-form-id').value; const name = document.getElementById('user-form-name').value.trim(); const ci = document.getElementById('user-form-ci').value.trim(); const phone = document.getElementById('user-form-phone').value.trim(); const role = document.getElementById('user-form-role').value.trim(); if(!name||!ci) return showToast("Nombre y CI son obligatorios", "error"); if(id) { const u = mockUsers.find(u => u.id === id); if(u) { u.name=name; u.ci=ci; u.phone=phone; u.role=role; showToast("Usuario actualizado"); } } else { mockUsers.push({id: `usr_${Date.now()}`, name, ci, phone, role}); showToast("Usuario creado"); } cancelEditUser(); renderUsers(); updateDropdowns(); }

        function renderSuppliersList() {
            const container = document.getElementById('supplier-list-container'); container.innerHTML = '';
            mockSuppliers.forEach(sup => { const div = document.createElement('div'); div.className = `p-3 mb-2 rounded-xl border cursor-pointer transition-colors ${activeSupplierId === sup.id ? 'bg-brand-50 border-brand-200' : 'bg-white border-slate-100 hover:bg-slate-50'}`; div.onclick = () => selectSupplier(sup.id); div.innerHTML = `<div class="flex items-center"><div class="h-10 w-10 rounded-full ${activeSupplierId === sup.id ? 'bg-brand-500 text-white' : 'bg-slate-100 text-slate-600'} flex items-center justify-center font-bold mr-3 flex-shrink-0 transition-colors">${sup.name.charAt(0)}</div><div class="overflow-hidden"><h4 class="text-sm font-bold text-slate-800 truncate">${sup.name}</h4><p class="text-xs text-slate-500 truncate">${sup.contact || 'Sin contacto'}</p></div></div>`; container.appendChild(div); });
        }
        function selectSupplier(id) { activeSupplierId = id; renderSuppliersList(); const sup = mockSuppliers.find(s => s.id === id); if(!sup) return; document.getElementById('supplier-placeholder').classList.add('hidden'); document.getElementById('supplier-detail-panel').classList.remove('hidden'); document.getElementById('sup-det-initial').innerText = sup.name.charAt(0); document.getElementById('sup-det-name').innerText = sup.name; document.getElementById('sup-det-contact').innerText = `${sup.contact || '-'} | ${sup.phone || '-'}`; renderSupplierPurchases(id); }
        function openSupplierModal(id = null) { document.getElementById('supplier-modal').classList.remove('hidden'); if (id) { const sup = mockSuppliers.find(s => s.id === id); document.getElementById('supplier-modal-title').innerHTML = '<i class="ph-fill ph-pencil-simple text-brand-500 mr-2"></i> Editar Proveedor'; document.getElementById('supplier-form-id').value = sup.id; document.getElementById('supplier-form-name').value = sup.name; document.getElementById('supplier-form-contact').value = sup.contact; document.getElementById('supplier-form-phone').value = sup.phone.replace('+591 ', ''); document.getElementById('supplier-form-email').value = sup.email; } else { document.getElementById('supplier-modal-title').innerHTML = '<i class="ph-fill ph-address-book text-brand-500 mr-2"></i> Nuevo Proveedor'; document.getElementById('supplier-form-id').value = ''; document.getElementById('supplier-form-name').value = ''; document.getElementById('supplier-form-contact').value = ''; document.getElementById('supplier-form-phone').value = ''; document.getElementById('supplier-form-email').value = ''; } }
        function editCurrentSupplier() { if(activeSupplierId) openSupplierModal(activeSupplierId); }
        function saveSupplier() { const idInput = document.getElementById('supplier-form-id').value; const name = document.getElementById('supplier-form-name').value.trim(); const contact = document.getElementById('supplier-form-contact').value.trim(); const phone = document.getElementById('supplier-form-phone').value.trim(); const email = document.getElementById('supplier-form-email').value.trim(); if(!name) return showToast("El nombre de la empresa es obligatorio", "error"); let finalPhone = phone ? (phone.startsWith('+') ? phone : `+591 ${phone}`) : ''; if (idInput) { const sup = mockSuppliers.find(s => s.id == idInput); if (sup) { sup.name = name; sup.contact = contact; sup.phone = finalPhone; sup.email = email; showToast("Datos actualizados."); } } else { const newId = mockSuppliers.length > 0 ? Math.max(...mockSuppliers.map(s => s.id)) + 1 : 1; mockSuppliers.push({ id: newId, name, contact, phone: finalPhone, email }); showToast("Nuevo proveedor registrado."); } closeModal('supplier-modal'); updateDropdowns(); renderSuppliersList(); if (activeSupplierId == idInput) selectSupplier(activeSupplierId); }
        function renderSupplierPurchases(id) { if(id === null) return; const tbody = document.getElementById('supplier-purchases-table'); tbody.innerHTML = ''; const purchases = mockPurchasesHistory.filter(p => p.supplierId === id); let totalSpent = 0; if(purchases.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-10 text-center text-slate-400">No hay compras registradas para este proveedor.</td></tr>'; } else { purchases.forEach(p => { totalSpent += p.total; const statusColor = p.status === 'Recibida' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'; tbody.innerHTML += `<tr class="hover:bg-slate-50 border-b border-slate-50 cursor-pointer transition-colors" onclick="openPOModal('${p.id}')"><td class="px-6 py-4 text-xs text-slate-500 align-middle">${p.date}</td><td class="px-6 py-4 font-bold text-brand-600 hover:text-brand-800 align-middle">${p.id}</td><td class="px-6 py-4 align-middle"><span class="${statusColor} px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wide">${p.status}</span></td><td class="px-6 py-4 text-sm text-slate-600 align-middle">${p.itemsRes}</td><td class="px-6 py-4 text-right font-bold text-slate-900 align-middle">${formatBs(p.total)}</td></tr>`; }); } document.getElementById('sup-det-total').innerText = formatBs(totalSpent); }

        function promptDelete(type, id) { itemToDeleteId = id; itemToDeleteType = type; document.getElementById('delete-modal-title').innerText = '¿Eliminar Elemento?'; document.getElementById('delete-modal').classList.remove('hidden'); }
        function executeDelete() { if(itemToDeleteType === 'branch') { mockBranches = mockBranches.filter(b => b.id !== itemToDeleteId); renderBranches(); showToast("Sucursal eliminada", "success"); } else if (itemToDeleteType === 'courier') { mockCouriers = mockCouriers.filter(c => c.id !== itemToDeleteId); renderCouriers(); showToast("Operador eliminado", "success"); } else if (itemToDeleteType === 'user') { mockUsers = mockUsers.filter(u => u.id !== itemToDeleteId); renderUsers(); showToast("Usuario eliminado", "success"); } else if (itemToDeleteType === 'category') { mockCategories = mockCategories.filter(c => c.id !== itemToDeleteId); renderCategories(); showToast("Categoría eliminada", "success"); } updateDropdowns(); closeModal('delete-modal'); itemToDeleteId = null; itemToDeleteType = null; }

        function renderKardex() {
            const tbody = document.getElementById('kardex-table'); if(!tbody) return; tbody.innerHTML = '';
            if(mockKardex.length === 0) { tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-8 text-center text-slate-400">No hay movimientos.</td></tr>'; return; }
            
            // Agrupar por Documento y SKU para operaciones independientes
            const grouped = {};
            mockKardex.forEach(mov => {
                const key = `${mov.docId}_${mov.baseSku}`;
                if(!grouped[key]) {
                    grouped[key] = { docId: mov.docId, date: mov.date, user: mov.user, type: mov.type, sku: mov.baseSku, name: mov.name, image: mov.image, movs: [] };
                }
                grouped[key].movs.push(mov);
            });

            Object.values(grouped).forEach((group, index) => {
                const safeId = `kardex_grp_${index}`;
                const isPos = group.movs[0].qty > 0;
                const typeColor = isPos ? 'bg-emerald-100 text-emerald-700 border-emerald-200' : 'bg-amber-100 text-amber-700 border-amber-200';

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 border-b border-slate-100 cursor-pointer transition-colors group-row" onclick="toggleKardexDetail('${safeId}')">
                        <td class="px-6 py-4 align-middle">
                            <span class="font-bold text-slate-700 text-xs block mb-1">${group.date.split(' ')[0]} <span class="text-slate-400 font-normal ml-1">${group.date.split(' ')[1] || ''}</span></span>
                            <span class="font-mono text-[10px] bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 border border-slate-200 shadow-sm">${group.docId}</span>
                        </td>
                        <td class="px-6 py-4 align-middle"><div class="flex items-center"><img src="${group.image}" class="w-10 h-10 rounded-md object-cover border border-slate-200 mr-3 flex-shrink-0"><div><span class="font-bold text-slate-800 font-mono text-sm">${group.sku}</span><br><span class="text-[10px] text-slate-500 truncate w-40 block">${group.name}</span></div></div></td>
                        <td class="px-6 py-4 text-center align-middle"><span class="${typeColor} border px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide inline-block shadow-sm">${group.type}</span></td>
                        <td class="px-6 py-4 text-right align-middle pr-8"><div class="flex items-center justify-end gap-2"><span class="text-xs font-medium text-slate-500 bg-slate-50 px-2 py-1 rounded border border-slate-100">${group.movs.length} talla(s)</span><button class="text-slate-400 group-hover:text-brand-600 transition-colors p-1"><i class="ph-bold ph-caret-down transition-transform text-lg" id="icon-${safeId}"></i></button></div></td>
                    </tr>
                    <tr id="detail-${safeId}" class="hidden bg-slate-50/70 shadow-inner">
                        <td colspan="4" class="p-0 border-b-2 border-slate-200">
                            <div class="px-10 py-5">
                                <table class="w-full text-left text-xs bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                                    <thead class="bg-slate-100"><tr class="text-slate-500 uppercase tracking-wider"><th class="px-4 py-3 font-semibold">Talla / Variante</th><th class="px-4 py-3 font-semibold text-right">Cant. Movimiento</th><th class="px-4 py-3 font-semibold text-right">Saldo Central</th><th class="px-4 py-3 font-semibold text-right">Operador</th></tr></thead>
                                    <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                                        ${group.movs.map(m => {
                                            const mIsPos = m.qty > 0;
                                            return `<tr class="hover:bg-slate-50">
                                                    <td class="px-4 py-3"><span class="bg-slate-100 px-2 py-1 rounded border border-slate-200 font-semibold shadow-sm text-slate-600">${m.size}</span></td>
                                                    <td class="px-4 py-3 text-right font-bold text-sm ${mIsPos ? 'text-emerald-600' : 'text-amber-600'}">${mIsPos?'+':''}${m.qty}</td>
                                                    <td class="px-4 py-3 text-right font-bold text-sm text-slate-800">${m.result}</td>
                                                    <td class="px-4 py-3 text-slate-500 text-right"><i class="ph-fill ph-user-circle mr-1 text-slate-400"></i> ${m.user}</td>
                                                </tr>`;
                                        }).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>`;
            });
        }
        function toggleKardexDetail(id) { const el = document.getElementById(`detail-${id}`); const icon = document.getElementById(`icon-${id}`); if(el.classList.contains('hidden')) { el.classList.remove('hidden'); icon.classList.add('rotate-180'); } else { el.classList.add('hidden'); icon.classList.remove('rotate-180'); } }

    </script>
</body>
</html>
