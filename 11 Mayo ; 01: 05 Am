            if(hasError) showToast("Costos deben ser mayores a 0 y cantidades válidas", "warning");
            if(addedCount > 0) {
                renderPOTable(); document.getElementById('po-add-panel').classList.add('hidden'); document.getElementById('po-search').value = ''; selectedProductForPO = null; showToast(`${addedCount} variante(s) agregada(s)`);
