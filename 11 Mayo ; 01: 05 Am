<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ComfortLife - ERP Modular</title>
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Fuente Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca' }
                    }
                }
            }
        }
    </script>
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Ocultar barra de desplazamiento */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Estilos para el Modal de Impresión (A4) */
        .a4-sheet {
            width: 21cm;
            min-height: 29.7cm;
            padding: 2cm;
            margin: 0 auto;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        @media print {
            body * { visibility: hidden; }
            .print-modal, .print-modal * { visibility: visible; }
            .print-modal { position: absolute; left: 0; top: 0; width: 100%; height: auto; z-index: 9999; background: white; padding: 0; }
            .a4-sheet { box-shadow: none; margin: 0; padding: 1cm; width: 100%; min-height: auto; }
            .no-print { display: none !important; }
        }

        /* Animaciones */
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .toast-enter { animation: slideInRight 0.3s ease-out forwards; }
        .rotate-180 { transform: rotate(180deg); }
        .transition-transform { transition-property: transform; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 300ms; }
    </style>
</head>
<body class="text-slate-800 h-screen overflow-hidden flex">

    <aside class="w-20 md:w-64 bg-white border-r border-slate-200 flex flex-col justify-between h-full transition-all duration-300 z-10 relative shadow-sm">
        <div class="overflow-y-auto no-scrollbar">
            <!-- Logo -->
            <div class="h-16 flex items-center justify-center md:justify-start md:px-6 border-b border-slate-100 flex-shrink-0">
                <i class="ph-fill ph-first-aid text-brand-600 text-3xl"></i>
                <span class="ml-3 font-bold text-lg text-slate-800 hidden md:block tracking-tight">ComfortLife</span>
            </div>

            <!-- Navegación -->
            <nav class="mt-6 px-3 flex flex-col gap-1 pb-4">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-brand-600 bg-brand-50 border-r-4 border-brand-500 transition-colors">
                    <i class="ph ph-squares-four text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Dashboard</span>
                </button>
                
                <!-- Sección Compras -->
                <div class="mt-2">
                    <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 hidden md:block">Compras</p>
                    <button onclick="switchTab('purchases')" id="nav-purchases" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                        <i class="ph ph-shopping-cart-simple text-2xl md:text-xl"></i>
                        <span class="ml-3 font-medium hidden md:block">Nuevo Ingreso (OC)</span>
                    </button>
                    <button onclick="switchTab('po-history')" id="nav-po-history" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                        <i class="ph ph-list-dashes text-2xl md:text-xl md:ml-4"></i>
                        <span class="ml-3 font-medium hidden md:block">Historial Ingresos</span>
                    </button>
                </div>
                
                <!-- Sección Despachos -->
                <div class="mt-2">
                    <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 hidden md:block">Despachos</p>
                    <button onclick="switchTab('dispatch')" id="nav-dispatch" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                        <i class="ph ph-truck text-2xl md:text-xl"></i>
                        <span class="ml-3 font-medium hidden md:block">Nuevo Despacho</span>
                    </button>
                    <button onclick="switchTab('dispatch-history')" id="nav-dispatch-history" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                        <i class="ph ph-clock-counter-clockwise text-2xl md:text-xl md:ml-4"></i>
                        <span class="ml-3 font-medium hidden md:block">Historial Despachos</span>
                    </button>
                </div>

                <div class="my-2 border-t border-slate-100"></div>
                
                <!-- Sección Logística -->
                <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 mt-2 hidden md:block">Logística</p>
                <button onclick="switchTab('couriers')" id="nav-couriers" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-airplane-tilt text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Operadores Courier</span>
                </button>

                <div class="my-2 border-t border-slate-100"></div>

                <!-- Botones de Gestión -->
                <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 mt-2 hidden md:block">Administración</p>
                <!-- NUEVO BOTON: CATEGORIAS -->
                <button onclick="switchTab('categories')" id="nav-categories" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-folders text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Categorías</span>
                </button>
                <button onclick="switchTab('products')" id="nav-products" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-package text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Productos (Maestro)</span>
                </button>
                <button onclick="switchTab('kardex')" id="nav-kardex" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-file-text text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Kardex General</span>
                </button>
                <button onclick="switchTab('branches')" id="nav-branches" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-storefront text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Sucursales</span>
                </button>
                <button onclick="switchTab('suppliers')" id="nav-suppliers" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-address-book text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Proveedores</span>
                </button>
                <button onclick="switchTab('users')" id="nav-users" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i class="ph ph-users text-2xl md:text-xl"></i>
                    <span class="ml-3 font-medium hidden md:block">Usuarios</span>
                </button>
            </nav>
        </div>

        <!-- Usuario Activo -->
        <div class="p-4 border-t border-slate-100 flex items-center justify-center md:justify-start flex-shrink-0">
            <div class="h-10 w-10 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 font-bold border border-brand-200 flex-shrink-0">
                <span id="user-initial">M</span>
            </div>
            <div class="ml-3 hidden md:block overflow-hidden">
                <p class="text-sm font-semibold text-slate-900 truncate" id="user-name">Usuario</p>
                <p class="text-xs text-slate-500 truncate" id="user-role">Rol</p>
            </div>
        </div>
    </aside>

    <main class="flex-1 h-full overflow-y-auto bg-slate-50 no-scrollbar relative">
        
        <!-- ================= PESTAÑA: DASHBOARD ================= -->
        <section id="tab-dashboard" class="p-6 md:p-10 max-w-7xl mx-auto tab-content block">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-slate-900">Resumen de Operaciones</h1>
                <p class="text-slate-500 mt-1">Control general de inventario y movimientos en Almacén Central.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-center">
                    <div class="h-14 w-14 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-2xl flex-shrink-0">
                        <i class="ph ph-money"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-slate-500">Valor Inventario (Almacén)</p>
                        <h3 class="text-2xl font-bold text-slate-900" id="dash-inventory-value">Bs 0.00</h3>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-center">
                    <div class="h-14 w-14 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 text-2xl flex-shrink-0">
                        <i class="ph ph-warning-circle"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-slate-500">Alertas de Stock (< 5)</p>
                        <h3 class="text-2xl font-bold text-slate-900" id="dash-low-stock-count">0</h3>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex items-center">
                    <div class="h-14 w-14 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 text-2xl flex-shrink-0">
                        <i class="ph ph-package"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-slate-500">Despachos Procesados</p>
                        <h3 class="text-2xl font-bold text-slate-900" id="dash-dispatch-count">0</h3>
                    </div>
                </div>
            </div>

            <!-- Alertas de Stock Bajo -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                    <h2 class="text-lg font-semibold text-slate-800 flex items-center">
                        <i class="ph-fill ph-warning text-rose-500 mr-2"></i> Artículos con Stock Crítico (Almacén Central)
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                <th class="px-6 py-4 font-medium">Producto (SKU)</th>
                                <th class="px-6 py-4 font-medium">Ubicación</th>
                                <th class="px-6 py-4 font-medium text-center">Talla/Medida</th>
                                <th class="px-6 py-4 font-medium text-right">Stock Actual</th>
                            </tr>
                        </thead>
                        <tbody id="low-stock-table" class="text-sm text-slate-700 divide-y divide-slate-100">
                            <!-- JS Populates -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= PESTAÑA: COMPRAS ================= -->
        <section id="tab-purchases" class="p-6 md:p-10 max-w-7xl mx-auto tab-content hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Crear Ingreso / Orden de Compra</h1>
                    <p class="text-slate-500 mt-1">Registra la entrada de mercancía. Solo "Recibida" actualiza el Kardex.</p>
                </div>
                <div class="flex items-center space-x-3 bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm">
                    <div class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></div>
                    <span class="text-sm font-medium text-slate-700">Responsable: <span id="po-user-name" class="font-bold text-brand-600">Manuel</span></span>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Columna Izquierda: Formulario -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1 uppercase tracking-wider">Estado de la Orden</label>
                                <select id="po-status" class="w-full border-slate-200 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-slate-50 font-medium">
                                    <option value="Borrador">Borrador</option>
                                    <option value="En Tránsito">En Tránsito</option>
                                    <option value="Recibida" selected>Recibida (Aplica Stock y Kardex)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1 uppercase tracking-wider">Proveedor</label>
                                <select id="po-supplier" class="w-full border-slate-200 rounded-lg border p-2.5 text-sm focus:ring-2 focus:ring-brand-500 outline-none bg-white">
                                    <!-- JS Populates from mockSuppliers -->
                                </select>
                            </div>
                        </div>

                        <div class="relative mt-2">
                            <label class="block text-xs font-medium text-slate-500 mb-1 uppercase tracking-wider">Buscar Producto a Ingresar</label>
                            <div class="flex gap-2 w-full">
                                <div class="relative flex-1">
                                    <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                    <input type="text" id="po-search" autocomplete="off" placeholder="Escribe SKU o nombre..." class="w-full border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm focus:ring-2 focus:ring-brand-500 outline-none transition-all bg-slate-50 focus:bg-white">
                                    <div id="po-search-results" class="hidden absolute w-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-20 max-h-48 overflow-y-auto"></div>
                                </div>
                                <button onclick="openCatalogModal('po')" class="bg-brand-50 text-brand-700 border border-brand-200 hover:bg-brand-100 px-4 py-3 rounded-xl text-sm font-medium transition-colors flex items-center shadow-sm flex-shrink-0">
                                    <i class="ph ph-books mr-2 text-lg"></i> Catálogo
                                </button>
                            </div>
                        </div>
                        
                        <!-- Panel de adición de tallas múltiples -->
                        <div id="po-add-panel" class="hidden mt-4 p-5 bg-brand-50 border border-brand-100 rounded-xl">
                            <div class="flex items-center mb-4 pb-3 border-b border-brand-200/50">
                                <img id="po-selected-img" src="" class="w-12 h-12 rounded-lg object-cover border border-slate-200 mr-3 hidden shadow-sm" alt="Min">
                                <div>
                                    <h4 class="font-bold text-brand-800 text-sm" id="po-selected-product">Producto Seleccionado</h4>
                                    <p class="text-xs text-brand-600 mt-0.5">Ingresa las cantidades y el costo de compra de esta orden.</p>
                                </div>
                            </div>
                            
                            <!-- Contenedor dinámico de filas (variantes) -->
                            <div id="po-variant-rows-container" class="space-y-3">
                                <!-- JS inyecta filas aquí -->
                            </div>
                            
                            <div class="mt-4 pt-2 flex flex-col sm:flex-row gap-3">
                                <button onclick="addVariantRowPO()" class="sm:w-1/3 bg-white border border-brand-300 text-brand-700 font-medium py-2.5 rounded-lg hover:bg-brand-100 transition-colors text-sm flex items-center justify-center shadow-sm">
                                    <i class="ph ph-plus-circle mr-1.5 text-lg"></i> Otra Talla
                                </button>
                                <button onclick="addPORows()" class="sm:w-2/3 bg-brand-600 text-white font-medium py-2.5 rounded-lg hover:bg-brand-700 transition-colors text-sm flex items-center justify-center shadow-md">
                                    <i class="ph ph-list-plus mr-2 text-lg"></i> Agregar Variantes a la Orden
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tabla PO -->
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                        <th class="px-4 py-3 font-medium">SKU / Producto</th>
                                        <th class="px-4 py-3 font-medium text-center">Talla</th>
                                        <th class="px-4 py-3 font-medium text-center">Cant.</th>
                                        <th class="px-4 py-3 font-medium text-right">Costo Unit.</th>
                                        <th class="px-4 py-3 font-medium text-right">Subtotal</th>
                                        <th class="px-4 py-3 font-medium text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="po-items-table" class="text-sm text-slate-700 divide-y divide-slate-100">
                                    <tr id="po-empty-row"><td colspan="6" class="px-4 py-8 text-center text-slate-400">No hay productos agregados.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Costo de Aterrizaje -->
                <div class="space-y-6">
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sticky top-6">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center">
                            <i class="ph-fill ph-calculator text-brand-500 mr-2"></i> Costo de Aterrizaje
                        </h3>
                        
                        <div class="space-y-4">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-500">Subtotal Mercancía:</span>
                                <span class="text-sm font-semibold text-slate-800" id="po-calc-subtotal">Bs 0.00</span>
                            </div>
                            <hr class="border-slate-100">
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1">Costo Flete Nacional (Bs)</label>
                                <input type="number" id="po-calc-shipping" value="0" min="0" oninput="calculatePOCosts()" class="w-full border border-slate-200 rounded-lg p-2 text-sm text-right focus:ring-2 focus:ring-brand-500 outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1">Impuestos / Aduana (Bs)</label>
                                <input type="number" id="po-calc-tax" value="0" min="0" oninput="calculatePOCosts()" class="w-full border border-slate-200 rounded-lg p-2 text-sm text-right focus:ring-2 focus:ring-brand-500 outline-none">
                            </div>
                            
                            <!-- Sección Courier -->
                            <div class="p-3 bg-brand-50 rounded-xl border border-brand-100">
                                <label class="block text-xs font-medium text-brand-800 mb-1">Operador Courier (Logística)</label>
                                <select id="po-calc-courier" class="w-full border border-brand-200 rounded-lg p-2 mb-2 text-sm outline-none bg-white focus:ring-2 focus:ring-brand-500 text-slate-700">
                                    <option value="">Seleccionar Courier (Opcional)</option>
                                    <!-- JS Populates -->
                                </select>
                                <label class="block text-xs font-medium text-brand-800 mb-1">Pago Courier (Bs)</label>
                                <input type="number" id="po-calc-courier-cost" value="0" min="0" oninput="calculatePOCosts()" class="w-full border border-brand-200 rounded-lg p-2 text-sm text-right focus:ring-2 focus:ring-brand-500 outline-none bg-white font-medium">
                            </div>

                            <hr class="border-slate-100">
                            <div class="flex justify-between items-center bg-slate-50 p-3 rounded-lg border border-slate-100">
                                <span class="text-sm font-bold text-slate-700">Costo Total Final:</span>
                                <span class="text-lg font-bold text-brand-600" id="po-calc-total">Bs 0.00</span>
                            </div>
                            <div class="mt-4 bg-emerald-50 border border-emerald-100 rounded-lg p-3">
                                <p class="text-xs text-emerald-800 text-center leading-relaxed">
                                    Si el estado es "Recibida", los costos promediarán el valor del inventario en Kardex.
                                </p>
                            </div>
                            <button onclick="savePO()" class="w-full mt-2 bg-slate-900 text-white font-semibold py-3 rounded-xl hover:bg-slate-800 transition-colors shadow-sm flex justify-center items-center">
                                <i class="ph ph-floppy-disk mr-2"></i> Guardar Orden
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PESTAÑA: HISTORIAL INGRESOS ================= -->
        <section id="tab-po-history" class="p-6 md:p-10 max-w-7xl mx-auto tab-content hidden">
            <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Historial de Órdenes de Compra</h1>
                    <p class="text-slate-500 mt-1">Todas las órdenes creadas. Cambia a "Recibida" para aplicar stock.</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="px-6 py-4 font-medium">Nº OC</th>
                                <th class="px-6 py-4 font-medium">Fecha</th>
                                <th class="px-6 py-4 font-medium">Proveedor</th>
                                <th class="px-6 py-4 font-medium text-center">Items</th>
                                <th class="px-6 py-4 font-medium text-right">Monto Total</th>
                                <th class="px-6 py-4 font-medium text-center">Estado y Acción</th>
                            </tr>
                        </thead>
                        <tbody id="po-history-table" class="text-sm text-slate-700 divide-y divide-slate-100">
                            <!-- JS Populates -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= PESTAÑA: DESPACHOS ================= -->
        <section id="tab-dispatch" class="p-6 md:p-10 max-w-7xl mx-auto tab-content hidden">
