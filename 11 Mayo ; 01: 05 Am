        function removePOItem(idx) { poItems.splice(idx, 1); renderPOTable(); }

        function calculatePOCosts() {
            const subtotal = poItems.reduce((sum, item) => sum + (item.qty * item.cost), 0);
            const shipping = parseFloat(document.getElementById('po-calc-shipping').value) || 0; const tax = parseFloat(document.getElementById('po-calc-tax').value) || 0; const courierCost = parseFloat(document.getElementById('po-calc-courier-cost').value) || 0;
            const total = subtotal + shipping + tax + courierCost;
            document.getElementById('po-calc-subtotal').innerText = formatBs(subtotal); document.getElementById('po-calc-total').innerText = formatBs(total);
        }

        function applyPOToStock(po) {
            const now = new Date().toISOString().slice(0,16).replace('T', ' ');
            po.items.forEach(item => {
                const prodRef = mockProducts.find(p => p.sku === item.product.sku);
                if(!prodRef) return; // fail safe
                
