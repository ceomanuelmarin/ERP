        function addPORows() {
            if(!selectedProductForPO) return;
            const rows = document.querySelectorAll('.po-variant-row'); if(rows.length === 0) return showToast("Agrega al menos una variante", "error");
            let addedCount = 0; let hasError = false;
            rows.forEach(row => {
                const size = row.querySelector('.po-var-size').value; const qty = parseInt(row.querySelector('.po-var-qty').value); const cost = parseFloat(row.querySelector('.po-var-cost').value);
                if(!size || qty <= 0 || isNaN(qty) || isNaN(cost) || cost <= 0) { hasError = true; return; }
                poItems.push({ product: selectedProductForPO, size, qty, cost }); addedCount++;
