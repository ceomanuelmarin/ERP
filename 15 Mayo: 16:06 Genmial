// 1. Llenar la lista de Categorías Padre
function fillProductDropdowns() {
    const catSelect = document.getElementById('product-form-cat');
    if (!catSelect || !window.firebaseCategories) return;

    // Le ponemos un "oído" para que escuche cuando cambias de categoría
    if (!catSelect.dataset.listenerAttached) {
        catSelect.addEventListener('change', () => updateSubcategories());
        catSelect.dataset.listenerAttached = 'true';
    }

    const selectedCat = catSelect.value;
    const parentCategories = window.firebaseCategories.filter(c => !c.parentId || String(c.parentId).trim() === "");

    catSelect.innerHTML = '<option value="">Selecciona Categoría</option>';
    parentCategories.forEach(cat => {
        catSelect.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
    });
    
    if (selectedCat) catSelect.value = selectedCat;
    
    // Cargamos los hijos correspondientes al padre actual
    updateSubcategories();
}

// 2. Llenar las Subcategorías SOLAMENTE del Padre seleccionado
function updateSubcategories(subcatToSelect = "") {
    const catSelect = document.getElementById('product-form-cat');
    const subcatSelect = document.getElementById('product-form-subcat');
    if (!catSelect || !subcatSelect || !window.firebaseCategories) return;

    const parentId = catSelect.value;
    const valueToKeep = subcatToSelect || subcatSelect.value; 

    subcatSelect.innerHTML = '<option value="">Sin Subcategoría</option>';

    // Si hay un padre seleccionado, buscamos solo a sus hijos
    if (parentId) {
        const children = window.firebaseCategories.filter(c => c.parentId === parentId);
        children.forEach(sub => {
            subcatSelect.innerHTML += `<option value="${sub.name}">${sub.name}</option>`;
        });
    }

    if (valueToKeep) subcatSelect.value = valueToKeep;
}

// 3. Parche inteligente para el Lápiz de Editar
if (typeof window.editProduct === 'function' && !window.editProductPatched) {
    const originalEdit = window.editProduct;
    window.editProduct = function(sku) {
        originalEdit(sku); 
        
        setTimeout(() => {
            const prod = window.mockProducts.find(p => p.sku === sku);
            if (prod) {
                document.getElementById('product-form-id').value = prod.id; 
                
                const catSelect = document.getElementById('product-form-cat');
                const foundCat = window.firebaseCategories.find(c => c.id === prod._originalCategory || c.name === prod._originalCategory);
                
                if (foundCat) {
                    if (foundCat.parentId && String(foundCat.parentId).trim() !== "") {
                        if (catSelect) catSelect.value = foundCat.parentId;
                        updateSubcategories(foundCat.name); // Cargamos hijos y seleccionamos
                    } else {
                        if (catSelect) catSelect.value = foundCat.id;
                        updateSubcategories(prod.subcategory || ""); // Cargamos hijos y seleccionamos
                    }
                }
            }
        }, 150); 
    };
    window.editProductPatched = true; 
}

// 4. Parche para Guardar (respeta la relación Padre-Hijo)
if (typeof window.saveProductCRUD === 'function' && !window.saveProductCRUDPatch) {
    const originalSave = window.saveProductCRUD;
    window.saveProductCRUD = async function() {
        const catSelect = document.getElementById('product-form-cat');
        const subcatSelect = document.getElementById('product-form-subcat');
        if (subcatSelect && subcatSelect.value !== "") {
            // Se asegura de que la subcategoría pertenece al padre correcto
            const subCatInfo = window.firebaseCategories.find(c => c.name === subcatSelect.value && c.parentId === catSelect.value);
            if (subCatInfo && catSelect) {
                const tempOption = document.createElement("option");
                tempOption.value = subCatInfo.id;
                catSelect.appendChild(tempOption);
                catSelect.value = subCatInfo.id; 
            }
        }
        await originalSave();
    };
    window.saveProductCRUDPatch = true;
}
    
