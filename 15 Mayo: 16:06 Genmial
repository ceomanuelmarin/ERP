// 🗑️ MOTOR DE BORRADO EN CASCADA (FIREBASE)
// ==========================================
async function deleteCategory(id) {
    try {
        showToast("Eliminando de la Nube...", "info");
        
        const { doc, deleteDoc, collection, getDocs, query, where } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
        const basePath = "artifacts/comfort-life-master-ecom/public/data";

        // 1. ELIMINAR A LOS HIJOS (Subcategorías)
        const q = query(collection(window.db, `${basePath}/categories`), where("parentId", "==", id));
        const querySnapshot = await getDocs(q);
        for (const subDoc of querySnapshot.docs) {
            await deleteDoc(doc(window.db, `${basePath}/categories`, subDoc.id));
        }

        // 2. ELIMINAR AL PADRE
        await deleteDoc(doc(window.db, `${basePath}/categories`, id));

        showToast("Categoría y subcategorías eliminadas con éxito", "success");

        // Nota: No necesitamos recargar la pantalla aquí porque nuestro "Timbre" 
        // de Firebase lo hará automáticamente al detectar que se borró.

    } catch (error) {
        console.error("Error al eliminar de Firebase:", error);
        showToast("Error al eliminar de la nube", "error");
    }
}

