                        <span class="ml-3 font-medium hidden md:block">Historial Despachos</span>
                    </button>
                </div>
                
                <!-- Sección Logística -->
                <div class="mt-2 border-t border-slate-100 pt-2">
                    <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 hidden md:block">Logística</p>
                    <button onclick="switchTab('couriers')" id="nav-couriers" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                        <i class="ph ph-airplane-tilt text-2xl md:text-xl"></i>
                        <span class="ml-3 font-medium hidden md:block">Operadores Courier</span>
                    </button>
                </div>

                <!-- Botones de Gestión -->
                <div class="mt-2 border-t border-slate-100 pt-2">
                    <p class="px-4 text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1 hidden md:block">Administración</p>
                    <button onclick="switchTab('categories')" id="nav-categories" class="nav-btn w-full flex items-center p-3 md:px-4 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors">
