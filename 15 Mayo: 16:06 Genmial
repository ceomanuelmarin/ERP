        // Flujo POS - Paso 2: Talla y Cantidad
        function openPosSizeModal(sku) {
            selectedProductForPOS = mockProducts.find(p => p.sku === sku); if(!selectedProductForPOS) return;
            const branch = document.getElementById('pos-branch-select').value;
            
            document.getElementById('pos-add-img').src = selectedProductForPOS.image;
            document.getElementById('pos-add-sku').innerText = selectedProductForPOS.sku;
            document.getElementById('pos-add-name').innerText = selectedProductForPOS.name;
            document.getElementById('pos-add-price').innerText = formatBs(selectedProductForPOS.sellPrice);
            
            const sizeSelect = document.getElementById('pos-add-size'); sizeSelect.innerHTML = '';
            
            selectedProductForPOS.validSizes.forEach(size => {
                const available = selectedProductForPOS.stock[branch] && selectedProductForPOS.stock[branch][size] ? selectedProductForPOS.stock[branch][size] : 0;
                
                // Restar lo que ya esta en el carrito
                const inCart = salesCart.find(i => i.product.sku === sku && i.size === size);
                const actualAvailable = available - (inCart ? inCart.qty : 0);
                
                if(actualAvailable > 0) {
                    const opt = document.createElement('option'); opt.value = size; opt.text = `Talla ${size} (Disponibles: ${actualAvailable})`; opt.dataset.max = actualAvailable; sizeSelect.appendChild(opt);
                }
            });
            
            if(sizeSelect.options.length === 0) {
                showToast("No queda stock disponible de ninguna talla para agregar.", "error"); return;
            }
            
            updatePosSizeMax();
            document.getElementById('pos-size-modal').classList.remove('hidden');
        }

        function updatePosSizeMax() {
            const select = document.getElementById('pos-add-size'); if(select.options.length === 0) return;
            const max = parseInt(select.options[select.selectedIndex].dataset.max);
            document.getElementById('pos-add-max').innerText = `Max: ${max}`;
            document.getElementById('pos-add-qty').value = 1;
        }

        function modifyPosQty(change) {
            const input = document.getElementById('pos-add-qty');
            const select = document.getElementById('pos-add-size');
            const max = parseInt(select.options[select.selectedIndex].dataset.max);
            let val = parseInt(input.value) + change;
            if(val < 1) val = 1; if(val > max) val = max;
            input.value = val;
        }

        function confirmAddToCart() {
            if(!selectedProductForPOS) return;
            const size = document.getElementById('pos-add-size').value;
            const qty = parseInt(document.getElementById('pos-add-qty').value);
            if(!size || qty <= 0) return;
            
            const existing = salesCart.find(i => i.product.sku === selectedProductForPOS.sku && i.size === size);
            if(existing) { existing.qty += qty; } else { salesCart.push({ product: selectedProductForPOS, size, qty, price: selectedProductForPOS.sellPrice }); }
            
            closeModal('pos-size-modal'); selectedProductForPOS = null;
            renderPosCart(); renderSalesProducts(); // Refresh grid to update max counts
        }

        // Flujo POS - Carrito y Totales
        function renderPosCart() {
            const list = document.getElementById('pos-cart-list'); list.innerHTML = '';
            let subtotal = 0;
            
            if(salesCart.length === 0) {
                list.innerHTML = '<li class="p-8 text-center text-slate-400 text-sm">El carrito está vacío.<br>Selecciona productos a la izquierda.</li>';
                document.getElementById('pos-pay-btn').disabled = true;
            } else {
                salesCart.forEach((item, idx) => {
                    const st = item.qty * item.price; subtotal += st;
                    list.innerHTML += `
                        <li class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors group">
                            <div class="flex items-center w-2/3">
                                <img src="${item.product.image}" class="w-10 h-10 rounded-md border border-slate-200 mr-3">
                                <div class="overflow-hidden">
                                    <h5 class="text-xs font-bold text-slate-800 truncate leading-tight">${item.product.name}</h5>
                                    <p class="text-[10px] text-slate-500 mt-0.5"><span class="bg-slate-100 px-1 rounded font-medium">${item.size}</span> x ${item.qty} un.</p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <p class="text-sm font-bold text-brand-600">${formatBs(st)}</p>
                                <button onclick="removeFromPosCart(${idx})" class="text-[10px] text-rose-400 hover:text-rose-600 uppercase font-bold mt-1 opacity-0 group-hover:opacity-100 transition-opacity"><i class="ph-fill ph-trash mr-0.5"></i> Quitar</button>
                            </div>
                        </li>`;
                });
                document.getElementById('pos-pay-btn').disabled = false;
            }
            
            const discountInput = parseFloat(document.getElementById('pos-discount-input').value) || 0;
            posDiscount = discountInput > subtotal ? subtotal : discountInput; // No puede ser mayor
            if(discountInput !== posDiscount) document.getElementById('pos-discount-input').value = posDiscount;
            
            const total = subtotal - posDiscount;
            document.getElementById('pos-subtotal').innerText = formatBs(subtotal);
            document.getElementById('pos-total').innerText = formatBs(total);
            document.getElementById('pos-checkout-total').innerText = formatBs(total);
