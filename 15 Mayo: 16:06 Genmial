                    </div>
                    <div id="spark2" class="absolute bottom-0 left-0 right-0 translate-y-2 opacity-50 pointer-events-none"></div>
                </div>
                <!-- Tarjeta 3 -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 relative overflow-hidden flex flex-col justify-between h-32">
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-2xl flex-shrink-0 shadow-sm"><i class="ph-fill ph-package"></i></div>
                        <div><p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Despachos</p><h3 class="text-xl font-black text-slate-800" id="dash-dispatch-count">0</h3></div>
                    </div>
                    <div id="spark3" class="absolute bottom-0 left-0 right-0 translate-y-2 opacity-50 pointer-events-none"></div>
                </div>
                <!-- Tarjeta 4 -->
