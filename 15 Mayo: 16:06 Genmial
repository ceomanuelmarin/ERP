        function viewClientHistory(clientId) {
            const client = mockClients.find(c => c.id === clientId);
            if (!client) return;
            document.getElementById('crm-history-client-name').innerText = client.name;
            
            const tbody = document.getElementById('crm-history-table'); tbody.innerHTML = '';
            const history = mockSalesHistory.filter(s => s.client && s.client.id === clientId);
            
            if (history.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Este cliente aún no tiene compras registradas.</td></tr>';
            } else {
                history.forEach(sale => {
                    // 1. Formatear la Fecha y la Hora (12h AM/PM)
                    const [datePart, timePart] = sale.date.split(' ');
                    let formattedTime = '--:--';
                    if (timePart) {
                        let [hour, minute] = timePart.split(':');
                        hour = parseInt(hour, 10);
                        let ampm = hour >= 12 ? 'PM' : 'AM';
                        hour = hour % 12;
                        hour = hour ? hour : 12; // Si la hora es 0, se convierte en 12
                        formattedTime = `${hour}:${minute} ${ampm}`;
                    }

                    // 2. Agregar el SKU como una etiqueta (badge) antes del nombre del producto
                    const itemsHtml = sale.items.map(i => `
                        <div class="text-[10px] bg-slate-50 p-1.5 mb-1.5 rounded border border-slate-100 shadow-sm leading-tight flex items-start">
                            <span class="font-black text-brand-600 mr-1.5">${i.qty}x</span> 
                            <div class="flex-1">
                                <span class="font-mono text-[9px] bg-white border border-slate-200 text-slate-500 px-1 rounded mr-1 shadow-sm">${i.product.sku}</span>
                                <span class="font-bold text-slate-700">${i.product.name}</span> 
                                <span class="text-slate-500">(${i.size})</span>
                            </div>
                        </div>
                    `).join('');
                    
                    const destinoFinal = sale.destination ? sale.destination : (sale.client.city || '--');

                    tbody.innerHTML += `
                        <tr class="hover:bg-slate-50 transition-colors border-b border-slate-50">
                            <td class="p-4 align-top">
                                <span class="block text-xs font-bold text-slate-800 mb-0.5">${datePart}</span>
                                <span class="block text-[10px] text-slate-500 font-medium"><i class="ph-fill ph-clock mr-1"></i>${formattedTime}</span>
                            </td>
                            <td class="p-4 align-top font-mono text-[10px] font-bold text-slate-500"><span class="bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">${sale.id}</span></td>
                            <td class="p-4 align-top text-xs font-bold text-slate-600"><i class="ph-fill ph-user-circle mr-1 text-slate-400"></i>${sale.seller}</td>
                            <td class="p-4 align-top w-2/5">${itemsHtml}</td>
                            <td class="p-4 align-top text-[10px]">
                                <span class="bg-indigo-50 text-indigo-700 border border-indigo-100 px-2 py-0.5 rounded font-bold uppercase tracking-wider block mb-1 w-max">${sale.method}</span>
                                <span class="text-slate-500 font-bold"><i class="ph-fill ph-map-pin mr-1"></i>${destinoFinal}</span>
                            </td>
                            <td class="p-4 align-top text-right font-black text-brand-600 text-lg">${formatBs(sale.total)}</td>
                        </tr>
                    `;
                });
            }
            document.getElementById('crm-history-modal').classList.remove('hidden');
        }
