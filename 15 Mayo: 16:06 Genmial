<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ComfortLife - ERP Modular & POS</title>
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Fuente Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca' }
                    }
                }
            }
        }
    </script>
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Ocultar barra de desplazamiento */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Estilos para Modales de Impresión (A4) */
        .a4-sheet {
            width: 21cm;
            min-height: 29.7cm;
            padding: 2cm;
            margin: 0 auto;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        /* Estilos para Recibo Térmico (POS - 80mm) */
        .thermal-receipt {
            width: 80mm;
            padding: 5mm;
            margin: 0 auto;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            font-family: 'Courier New', Courier, monospace;
            color: #000;
        }

        @media print {
            body * { visibility: hidden; }
            .print-modal, .print-modal * { visibility: visible; }
            .print-modal { position: absolute; left: 0; top: 0; width: 100%; height: auto; z-index: 9999; background: white; padding: 0; }
            .a4-sheet { box-shadow: none; margin: 0; padding: 1cm; width: 100%; min-height: auto; }
            .thermal-receipt { box-shadow: none; margin: 0; padding: 2mm; width: 80mm; }
            .no-print { display: none !important; }
        }

        /* Animaciones */
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .toast-enter { animation: slideInRight 0.3s ease-out forwards; }
        .rotate-180 { transform: rotate(180deg); }
        .transition-transform { transition-property: transform; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 300ms; }
        /* Ajuste perfecto de íconos para la barra delgada (Solo Móvil) */
        @media (max-width: 767px) {
            /* Centrar y hacer cuadrados los botones del menú */
            #main-sidebar nav a, #main-sidebar nav button {
                justify-content: center !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
                width: 36px !important;
                height: 36px !important;
                margin: 0 auto 10px auto !important; /* Centrado perfecto */
                border-radius: 10px !important;
            }
            /* Reducir el tamaño del ícono y quitar márgenes */
            #main-sidebar nav i {
                margin: 0 !important;
                font-size: 20px !important;
            }
            /* Ocultar la línea izquierda del botón activo (se ve mejor como botón flotante) */
            #main-sidebar nav .border-l-4 {
                border-left: none !important;
            }
            /* Centrar el avatar (círculo con la M) del vendedor abajo */
            #main-sidebar > div:last-child {
                padding-left: 0 !important;
                padding-right: 0 !important;
                justify-content: center !important;
            }
        }
        /* Miniaturizar Tarjetas de Producto en el POS para 3 Columnas (Solo Móvil) */
        @media (max-width: 767px) {
            #pos-product-grid > div {
                padding: 0.35rem !important;
                border-radius: 0.5rem !important;
                border: 1px solid #e2e8f0 !important;
                box-shadow: none !important;
            }
            #pos-product-grid > div > div:first-child { /* Cuadrado de la Imagen */
                height: 3.5rem !important;
                border-radius: 0.375rem !important;
                margin-bottom: 0.35rem !important;
            }
            #pos-product-grid > div > div:first-child span { /* Texto dentro de imagen */
                font-size: 0.65rem !important;
                line-height: 1 !important;
            }
            #pos-product-grid > div > div:first-child .absolute { /* Etiqueta de Stock azul */
                font-size: 0.5rem !important;
                padding: 0.1rem 0.25rem !important;
                top: 0.2rem !important;
                right: 0.2rem !important;
            }
            #pos-product-grid > div p.text-\[9px\] { /* SKU */
                font-size: 0.45rem !important;
                margin-bottom: 0.1rem !important;
            }
            #pos-product-grid > div h3 { /* Nombre Producto */
                font-size: 0.55rem !important;
                line-height: 1.1 !important;
                margin-bottom: 0.2rem !important;
                white-space: nowrap !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
            }
            #pos-product-grid > div p.text-brand-600 { /* Precio */
                font-size: 0.75rem !important;
                margin-top: 0.2rem !important;
            }
        }
    </style>
    <!-- Motor de Gráficos ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
</head>
<body class="text-slate-800 h-screen overflow-hidden flex">

