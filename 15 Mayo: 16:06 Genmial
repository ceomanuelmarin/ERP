        function selectPaymentMethod(method) {
            document.querySelectorAll('.pay-method-btn').forEach(btn => btn.classList.remove('border-brand-500', 'text-brand-600', 'bg-brand-50'));
            const btn = document.getElementById(`pay-btn-${method}`);
            if(btn) btn.classList.add('border-brand-500', 'text-brand-600', 'bg-brand-50');
            document.getElementById('pos-selected-payment').value = method;
            document.getElementById('pos-confirm-sale-btn').disabled = false;
            
            const cashDetails = document.getElementById('pos-cash-details');
            const bankDetails = document.getElementById('pos-bank-details');
            
            if (method === 'Efectivo') {
                cashDetails.classList.remove('hidden');
                bankDetails.classList.add('hidden');
                calculatePosChange();
            } else if (method === 'QR' || method === 'Transferencia') {
                cashDetails.classList.add('hidden');
                bankDetails.classList.remove('hidden');
            } else {
                cashDetails.classList.add('hidden');
                bankDetails.classList.add('hidden');
            }
        }

        function calculatePosChange() {
            const received = parseFloat(document.getElementById('pos-cash-received').value) || 0;
            const subtotal = salesCart.reduce((sum, item) => sum + (item.qty * item.price), 0);
            const total = subtotal - posDiscount;
            const change = received - total;
            const changeEl = document.getElementById('pos-cash-change');
            
            if (change >= 0) {
                changeEl.innerText = formatBs(change);
                changeEl.classList.remove('text-rose-500');
                changeEl.classList.add('text-slate-800');
            } else {
                changeEl.innerText = 'Insuficiente';
                changeEl.classList.remove('text-slate-800');
