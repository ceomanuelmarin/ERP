async function uploadImage(file, sku) {
    if (!file) return "";
    try {
        const { getStorage, ref, uploadBytes, getDownloadURL } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-storage.js");
        
        const storage = getStorage(); 
        const extension = file.name.split('.').pop(); 
        const fileName = `products/${sku}_${Date.now()}.${extension}`; 
        const storageRef = ref(storage, fileName);
        
        const snapshot = await uploadBytes(storageRef, file);
        const downloadURL = await getDownloadURL(snapshot.ref);
        
        console.log("✅ Imagen subida a la nube:", downloadURL);
        return downloadURL;
    } catch (error) {
        console.error("🚨 Error al subir la foto:", error);
        return "";
    }
}

