                        ${totalStock <= 0 ? '<span class="absolute top-2 right-2 bg-rose-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded">Agotado</span>' : `<span class="absolute top-2 right-2 bg-brand-50 text-brand-600 border border-brand-200 text-[10px] font-bold px-1.5 py-0.5 rounded shadow-sm">${totalStock}</span>`}
