                            <button onclick="switchMainChart('ingresos')" id="tab-ingresos" class="px-3 py-1.5 rounded-md bg-white text-slate-800 shadow-sm transition-all">Ingresos Brutos</button>
                            <button onclick="switchMainChart('utilidad')" id="tab-utilidad" class="px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-700 transition-all">Utilidad Neta</button>
                        </div>
                    </div>
                    <div id="chart-revenue" class="w-full h-72"></div>
