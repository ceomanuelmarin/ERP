                        <i class="ph-fill ph-warning text-rose-500 mr-2"></i> Artículos con Stock Crítico (Almacén Central)
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                <th class="px-6 py-4 font-medium">Producto (SKU)</th>
                                <th class="px-6 py-4 font-medium">Ubicación</th>
                                <th class="px-6 py-4 font-medium text-center">Talla/Medida</th>
                                <th class="px-6 py-4 font-medium text-right">Stock Actual</th>
                            </tr>
                        </thead>
                        <tbody id="low-stock-table" class="text-sm text-slate-700 divide-y divide-slate-100">
                            <!-- JS Populates -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= PESTAÑA: VENTAS POS ================= -->
        <section id="tab-sales" class="p-1 md:p-6 lg:p-8 max-w-[1400px] mx-auto tab-content hidden h-full overflow-hidden flex flex-col relative bg-slate-100 md:bg-transparent">

            <!-- BARRA SUPERIOR -->
            <div class="flex justify-between items-center mb-1.5 md:mb-4 bg-white p-1.5 md:p-4 rounded-xl md:rounded-2xl border border-slate-200 shadow-sm flex-shrink-0 z-10">
