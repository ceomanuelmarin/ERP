// 📥 1. FUNCIÓN PARA EXPORTAR (Descargar plantilla)
function exportProductsCSV() {
    if (!window.mockProducts || window.mockProducts.length === 0) {
        return showToast("No hay productos para exportar", "error");
    }

    // AÑADIMOS PrecioNormal en los encabezados
    let csvContent = "SKU;Nombre;Categoria;Subcategoria;PrecioCosto;PrecioVenta;PrecioNormal;Variantes;ImagenURL;Activo\n";

    window.mockProducts.forEach(p => {
        let name = p.name ? p.name.replace(/;/g, "") : "Sin nombre"; // Limpiamos texto
        let cat = p.category || "";
        let subcat = p.subcategory || "";
        let vars = p.variants || "Unica";
        let img = p.image || "";

        // Armamos la fila agregando ${p.comparePrice || 0}
        let row = `${p.sku};${name};${cat};${subcat};${p.costPrice || 0};${p.price || 0};${p.comparePrice || 0};${vars};${img};${p.isActive}`;
        csvContent += row + "\n";
    });

    // Forzamos la descarga del archivo
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "plantilla_productos_comfortlife.csv";
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast("✅ Plantilla descargada", "success");
}

// 📤 2. FUNCIÓN PARA IMPORTAR (Subir Excel)
async function importProductsCSV(event) {
    const file = event.target.files[0];
    if (!file) return;

    showToast("⏳ Procesando archivo... no cierres la ventana.", "info");

    const reader = new FileReader();
    reader.onload = async function(e) {
        const text = e.target.result;
        const rows = text.split('\n'); // Separamos por lineas

        try {
            const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
            const basePath = "artifacts/comfort-life-master-ecom/public/data";
            let count = 0;

            // Empezamos desde 1 para saltar los encabezados (Títulos)
            for (let i = 1; i < rows.length; i++) {
                if (!rows[i].trim()) continue;

                const cols = rows[i].split(';'); // Separamos las columnas por punto y coma

                const sku = cols[0]?.trim();
                if (!sku) continue;

                // Armamos el paquete de datos leyendo la nueva columna (Posición 6)
                const productData = {
                    sku: sku,
                    name: cols[1]?.trim() || "Sin nombre",
                    category: cols[2]?.trim() || "",
                    subcategory: cols[3]?.trim() || "",
                    costPrice: parseFloat(cols[4]) || 0,
                    price: parseFloat(cols[5]) || 0,
                    comparePrice: parseFloat(cols[6]) || 0, // <--- AQUÍ LEE EL PRECIO NORMAL
                    variants: cols[7]?.trim() || "Unica",
                    image: cols[8]?.trim() || "",
                    isActive: cols[9]?.trim() !== 'false', // Si dice false, lo oculta. Si no, lo activa.
                    lastUpdate: new Date().toISOString()
                };

                // Enviamos a Firebase
                const productRef = doc(window.db, `${basePath}/products`, sku);
                await setDoc(productRef, productData, { merge: true });
                count++;
            }

            showToast(`✅ ¡Éxito! ${count} productos importados/actualizados.`, "success");
            event.target.value = ''; // Limpiamos el botón de archivo
            
            // Recargamos la página después de 2 segundos para ver los cambios
            setTimeout(() => location.reload(), 2000); 

        } catch (error) {
            console.error("Error importando:", error);
            showToast("❌ Hubo un error al guardar en la base de datos", "error");
        }
    };
    reader.readAsText(file);
}
    
