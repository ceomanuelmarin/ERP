        function switchMainChart(tipo) {
            // 1. Cambiamos los estilos de los botones (Cual está activo y cual no)
            const btnIngresos = document.getElementById('tab-ingresos');
            const btnUtilidad = document.getElementById('tab-utilidad');
            
            if (tipo === 'ingresos') {
                btnIngresos.className = "px-3 py-1.5 rounded-md bg-white text-slate-800 shadow-sm transition-all";
                btnUtilidad.className = "px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-700 transition-all";
                
                // 2. Le inyectamos los datos de INGRESOS al gráfico existente (Curva Morada)
                dashCharts.revenue.updateSeries([{ name: 'Ingresos Brutos', data: [1250, 1800, 1500, 2400, 2100, 2900, posDailySalesTotal > 0 ? posDailySalesTotal : 3200] }]);
                dashCharts.revenue.updateOptions({ 
                    colors: ['#6366f1'],
                    yaxis: { labels: { formatter: (val) => "Bs " + val } }
                });
                
            } else if (tipo === 'utilidad') {
                btnUtilidad.className = "px-3 py-1.5 rounded-md bg-white text-slate-800 shadow-sm transition-all";
                btnIngresos.className = "px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-700 transition-all";
                
                // Calculamos una Utilidad simulada (Ej: 40% de margen de ganancia) para los días pasados
                const utHoy = posDailySalesTotal > 0 ? (posDailySalesTotal * 0.4).toFixed(2) : 1280;
                
                // 3. Le inyectamos los datos de UTILIDAD al gráfico existente (Curva Verde)
                dashCharts.revenue.updateSeries([{ name: 'Utilidad Neta', data: [500, 720, 600, 960, 840, 1160, utHoy] }]);
                dashCharts.revenue.updateOptions({ 
                    colors: ['#10b981'], // Verde Esmeralda para ganancias
                    yaxis: { labels: { formatter: (val) => "Bs " + val } }
                });
            }
