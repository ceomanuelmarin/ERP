    </aside>

<!-- Botón Flotante para recuperar el menú oculto (Solo visible cuando se oculta la barra) -->
        <!-- Botón Flotante para recuperar el menú oculto (Superior Derecho) -->
        <button id="mobile-menu-btn" onclick="toggleSidebar()" class="fixed top-4 right-4 z-[60] bg-brand-600 text-white w-11 h-11 rounded-xl shadow-2xl flex items-center justify-center transition-transform hover:scale-105 hidden border border-brand-500">
            <i class="ph-bold ph-list text-xl"></i>
        </button>
    <main class="flex-1 h-full overflow-y-auto bg-slate-50 no-scrollbar relative">
        
       <!-- ================= PESTAÑA: DASHBOARD ================= -->
        <section id="tab-dashboard" class="p-6 md:p-10 max-w-7xl mx-auto tab-content">
            <div class="mb-8 flex justify-between items-end">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Panel de Control</h1>
                    <p class="text-slate-500 mt-1">Métricas de rendimiento, ventas y estado general del sistema.</p>
                </div>
            </div>

            <!-- TARJETAS KPI CON SPARKLINES -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Tarjeta 1 -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 relative overflow-hidden flex flex-col justify-between h-32">
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center text-2xl flex-shrink-0 shadow-sm"><i class="ph-fill ph-money"></i></div>
                        <div><p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-0.5">Inventario (Central)</p><h3 class="text-xl font-black text-slate-800" id="dash-inventory-value">Bs 0.00</h3></div>
                    </div>
                    <div id="spark1" class="absolute bottom-0 left-0 right-0 translate-y-2 opacity-50 pointer-events-none"></div>
                </div>
                <!-- Tarjeta 2 -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 relative overflow-hidden flex flex-col justify-between h-32">
                    <div class="flex items-center gap-4 relative z-10">
