        const { doc, setDoc, addDoc, collection } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
        const basePath = "artifacts/comfort-life-master-ecom/public/data";
        
        if (isEdit) {
            // ✏️ ACTUALIZAR PRODUCTO EXISTENTE (Usamos setDoc)
            const productRef = doc(window.db, `${basePath}/products`, idInput);
            await setDoc(productRef, productData, { merge: true });
            showToast("¡Precio/Datos actualizados en la Nube!", "success");
        } else {
            // ➕ CREAR PRODUCTO NUEVO (Exigiendo que el ID sea el SKU)
            const productRef = doc(window.db, `${basePath}/products`, sku);
