        function editCategory(id) {
    // 1. Buscamos la categoría directamente en FIREBASE
    const cat = window.firebaseCategories.find(x => x.id === id);
    if(!cat) return;

    // 2. Llenamos el ID oculto y el Nombre de la categoría principal
