        function renderPayments() {
            const search = document.getElementById('pay-search') ? document.getElementById('pay-search').value.toLowerCase() : '';
            const dest = document.getElementById('pay-filter-dest') ? document.getElementById('pay-filter-dest').value : '';
            const bank = document.getElementById('pay-filter-bank') ? document.getElementById('pay-filter-bank').value : '';
            const seller = document.getElementById('pay-filter-seller') ? document.getElementById('pay-filter-seller').value : '';
            const dateFilter = document.getElementById('pay-filter-date') ? document.getElementById('pay-filter-date').value : '';
            
            const tbody = document.getElementById('payments-table'); if(!tbody) return; tbody.innerHTML = '';

            const today = new Date();
            // Normalizamos la fecha de hoy para evitar problemas de horas
            const startOfToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());

            const filtered = mockPayments.filter(p => {
                // Filtros de texto y selectores
                const matchSearch = p.clientName.toLowerCase().includes(search) || p.docId.toLowerCase().includes(search) || (p.clientPhone && p.clientPhone.toLowerCase().includes(search));
                const matchDest = dest === '' || p.destination === dest;
                const matchBank = bank === '' || p.method.includes(bank); // Como el banco viene en formato "QR (BNB)", usamos includes
                const matchSeller = seller === '' || p.seller === seller;
                
                // Filtro de Fechas
                let matchDate = true;
                if (dateFilter !== '') {
                    // Extraemos solo la fecha (YYYY-MM-DD) y la convertimos a objeto Date
                    const pDateRaw = p.date.split(' ')[0];
                    const pDateParts = pDateRaw.split('-'); // [YYYY, MM, DD]
                    const pDateObj = new Date(pDateParts[0], pDateParts[1] - 1, pDateParts[2]);

                    if (dateFilter === 'hoy') {
                        matchDate = pDateObj.getTime() === startOfToday.getTime();
                    } else if (dateFilter === 'semana') {
                        const pastWeek = new Date(startOfToday);
                        pastWeek.setDate(startOfToday.getDate() - 7);
                        matchDate = pDateObj >= pastWeek && pDateObj <= startOfToday;
                    } else if (dateFilter === 'mes') {
                        matchDate = pDateObj.getMonth() === startOfToday.getMonth() && pDateObj.getFullYear() === startOfToday.getFullYear();
                    }
                }

                return matchSearch && matchDest && matchBank && matchSeller && matchDate;
            });

            if(filtered.length === 0) { tbody.innerHTML = '<tr><td colspan="9" class="p-8 text-center text-slate-400">No se encontraron pagos con estos filtros.</td></tr>'; return; }

            filtered.forEach(p => {
                let badgeStatus = p.status === 'Verificado' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700';
                
                let btnHtml = p.receipt ? 
                    `<button onclick="viewReceipt('${p.docId}')" class="text-brand-600 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-lg text-[10px] font-bold shadow-sm transition-colors border border-brand-200 flex items-center"><i class="ph-fill ph-file-pdf mr-1"></i> Ver Comprobante</button>` 
                    : 
                    `<div class="relative overflow-hidden inline-block"><button class="bg-slate-100 text-slate-600 px-3 py-1.5 rounded-lg text-[10px] font-bold hover:bg-slate-200 shadow-sm transition-colors flex items-center border border-slate-200"><i class="ph-fill ph-upload-simple mr-1 text-sm"></i> Subir Ref</button><input type="file" accept="image/*" class="absolute left-0 top-0 opacity-0 cursor-pointer w-full h-full" onchange="uploadReceipt(this, '${p.docId}')"></div>`;
                
                tbody.innerHTML += `<tr class="hover:bg-slate-50 transition-colors border-b border-slate-50">
                    <td class="p-4 align-middle text-xs text-slate-500">${p.date}</td>
                    <td class="p-4 align-middle font-bold text-slate-800 font-mono text-xs"><span class="bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">${p.docId}</span></td>
                    <td class="p-4 align-middle font-bold text-slate-800 text-sm leading-tight">${p.clientName} <br><span class="font-medium text-xs text-slate-400"><i class="ph-fill ph-phone mr-1"></i>${p.clientPhone}</span></td>
                    <td class="p-4 align-middle text-xs font-medium text-slate-600"><i class="ph-fill ph-user-circle text-slate-400 mr-1"></i>${p.seller}</td>
                    <td class="p-4 align-middle font-bold text-slate-700 text-xs">${p.destination || 'Tienda Física'}</td>
                    <td class="p-4 align-middle text-[10px] font-bold text-brand-600 uppercase tracking-wider">${p.method}</td>
                    <td class="p-4 align-middle font-black text-slate-900 text-right">${formatBs(p.total)}</td>
                    <td class="p-4 align-middle text-center flex justify-center">${btnHtml}</td>
                    <td class="p-4 align-middle text-center">
            <input type="text" 
                   placeholder="Ej: 987654" 
                   value="${p.nroTransaccion || ''}" 
                   onchange="guardarNroTransaccion('${p.docId}', this.value)" 
                   class="w-24 text-[10px] md:text-xs border border-slate-300 rounded px-2 py-1 outline-none focus:ring-2 focus:ring-brand-500 bg-white text-slate-800 font-bold placeholder-slate-300">
        </td>
                    <td class="p-4 align-middle text-center"><span class="${badgeStatus} px-2 py-1 rounded text-[10px] font-bold uppercase cursor-pointer shadow-sm" onclick="togglePaymentStatus('${p.docId}')">${p.status}</span></td>
                </tr>`;
            });
        }

