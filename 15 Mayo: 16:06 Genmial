        async function saveCategory() {
    const idInput = document.getElementById('category-form-id').value;
    const nameInput = document.getElementById('category-name').value.trim();

    if(!nameInput) return showToast("Nombre obligatorio", "error");

    // 1. Recogemos las Subcategorías actuales del formulario
    const subcatsInForm = [];
    document.querySelectorAll('.cat-sub-input').forEach(i => {
        if(i.value.trim()) subcatsInForm.push(i.value.trim());
    });

    try {
        showToast("Sincronizando con la Nube...", "info");
        // Importamos deleteDoc para poder borrar lo que sobre
        const { doc, setDoc, addDoc, collection, deleteDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
        const basePath = "artifacts/comfort-life-master-ecom/public/data";

        let parentId = idInput;

        // --- A. GUARDAR O ACTUALIZAR PADRE ---
        if (parentId) {
            const parentRef = doc(window.db, `${basePath}/categories`, parentId);
            await setDoc(parentRef, { name: nameInput }, { merge: true });
        } else {
            const parentRef = await addDoc(collection(window.db, `${basePath}/categories`), {
                name: nameInput,
                parentId: "",
                color: "#1e3a8a",
                image: "",
                faqId: "",
                templateId: ""
            });
            parentId = parentRef.id;
        }

        // --- B. SINCRONIZACIÓN "ESPEJO" DE SUBCATEGORÍAS ---
        // 1. Buscamos qué hay actualmente en Firebase para este padre
        const existingSubs = window.firebaseCategories.filter(c => c.parentId === parentId);
        
        // 2. BORRAR: Si está en Firebase pero ya no en el Formulario, lo eliminamos
        for (const sub of existingSubs) {
            if (!subcatsInForm.includes(sub.name)) {
                await deleteDoc(doc(window.db, `${basePath}/categories`, sub.id));
            }
        }

        // 3. AÑADIR: Si está en el Formulario pero no en Firebase, lo creamos
        for (const subName of subcatsInForm) {
            const alreadyInFirebase = existingSubs.find(s => s.name === subName);
            if (!alreadyInFirebase) {
                await addDoc(collection(window.db, `${basePath}/categories`), {
                    name: subName,
                    parentId: parentId,
                    color: "#1e3a8a",
                    image: "",
                    faqId: "",
                    templateId: ""
                });
            }
        }

        showToast("¡Categoría y Subcategorías sincronizadas!", "success");

        if(typeof cancelEditCategory === 'function') cancelEditCategory();
        
        // Actualizamos la vista
        setTimeout(() => { if(typeof renderCategories === 'function') renderCategories(); }, 800);

    } catch (error) {
        console.error("Error en la sincronización:", error);
        showToast("Error al sincronizar", "error");
    }
}

