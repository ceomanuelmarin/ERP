    const sizesRaw = document.getElementById('product-form-sizes').value.trim();
    const imageInput = document.getElementById('product-form-image-url').value.trim();

    // 2. Validamos que no falte nada importante
    if(!sku || !name || !catName || !sizesRaw || isNaN(sellPrice)) {
        return showToast("Faltan datos obligatorios (Incluyendo precio)", "error");
    }

    // 🧠 3. LA TRADUCCIÓN INVERSA (De ERP al idioma de la Tienda)
    
    // a) Recuperamos el ID secreto de la categoría (porque la tienda no usa el nombre)
    let categoryId = catName; 
    if (window.firebaseCategories) {
        const catInfo = window.firebaseCategories.find(c => c.name === catName || c.id === catName);
        if (catInfo) categoryId = catInfo.id;
    }

    // b) Empaquetamos los datos con los nombres exactos que usa tu tienda Online
    try {
        // --- 🚀 INICIO MAGIA DE FOTOS ---
        let finalImageUrl = imageInput; // Por defecto usa el link de texto
        const imageFile = document.getElementById('product-form-image-file').files[0]; // Busca si subiste un archivo
        
        if (imageFile) {
            showToast("Subiendo foto a la nube... ☁️", "info");
            const uploadedUrl = await uploadImage(imageFile, sku); // Sube la foto
            if (uploadedUrl) finalImageUrl = uploadedUrl; // Reemplaza el link por el oficial de Google
        }
        // --- 🚀 FIN MAGIA DE FOTOS ---

        // Armamos el paquete final con la foto real
        const productData = {
            sku: sku,
            name: name,
            category: categoryId,
            subcategory: subcategory,
            costPrice: costPrice || 0,
