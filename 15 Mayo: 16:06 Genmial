        if(typeof renderSalesProducts === 'function') renderSalesProducts();
    });

    // 🧠 MOTOR DE TRADUCCIÓN CONTINUA
    setInterval(() => {
        if (window.firebaseCategories && window.firebaseCategories.length > 0 && window.mockProducts && window.mockProducts.length > 0) {
            let changesMade = false;
            window.mockProducts.forEach(p => {
                const catInfo = window.firebaseCategories.find(c => c.id === p._originalCategory);
                if (catInfo && p.category !== catInfo.name) {
                    p.category = catInfo.name; 
                    changesMade = true;
                }
            });
            
            if (changesMade) {
                if(typeof renderProductsCRUD === 'function') renderProductsCRUD();
                if(typeof renderPOSCatalog === 'function') renderPOSCatalog();
            }
        }
    }, 1000); 
